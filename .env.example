# Receipt Manager - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Server Configuration
# ============================================

# Port the web server listens on
# Default: 8765 (avoids macOS AirPlay on port 5000)
PORT=8765

# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=127.0.0.1

# ============================================
# Data Storage
# ============================================

# Base directory for all data storage
# Default: ./data (relative to app root)
DATA_DIR=./data

# Database file location
# Default: ${DATA_DIR}/database/data.json
DATABASE_PATH=${DATA_DIR}/database/data.json

# Upload storage directory
# Default: ./storage
STORAGE_DIR=./storage

# Backup directory
# Default: ${DATA_DIR}/backups
BACKUP_DIR=${DATA_DIR}/backups

# ============================================
# OCR Configuration
# ============================================

# OCR language(s) - multiple languages separated by +
# Available: eng (English), nld (Dutch), ell (Greek), lav (Latvian)
# Example: eng+nld+ell+lav
OCR_LANGUAGE=eng+nld+ell+lav

# OCR engine preference
# Options: tesseract, easyocr, auto
# Default: auto (tries EasyOCR first, falls back to Tesseract)
OCR_ENGINE=auto

# Tesseract binary path (leave empty for system default)
# macOS Homebrew: /opt/homebrew/bin/tesseract or /usr/local/bin/tesseract
# Linux: /usr/bin/tesseract
TESSERACT_PATH=

# EasyOCR GPU support
# Set to true to use GPU acceleration (requires CUDA)
EASYOCR_GPU=false

# ============================================
# Application Settings
# ============================================

# Debug mode (true/false)
# Warning: Do not enable in production!
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE=50

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,bmp,tiff,webp

# ============================================
# Backup Settings
# ============================================

# Enable automatic backups
AUTO_BACKUP=true

# Backup interval in hours
BACKUP_INTERVAL=24

# Maximum number of backups to keep
MAX_BACKUPS=30

# ============================================
# UI Settings
# ============================================

# Default language for UI
# Options: en, nl, el, lv
UI_LANGUAGE=en

# Date format
# Options: DD/MM/YYYY, MM/DD/YYYY, YYYY-MM-DD
DATE_FORMAT=DD/MM/YYYY

# Currency symbol
CURRENCY=€

# ============================================
# Security (Future)
# ============================================

# Secret key for sessions (generate with: python -c 'import secrets; print(secrets.token_hex(32))')
# SECRET_KEY=your-secret-key-here

# Enable authentication (not yet implemented)
# ENABLE_AUTH=false
