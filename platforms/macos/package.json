{
  "name": "receipt-warranty-manager",
  "version": "2.3.3",
  "description": "Receipt & Warranty Manager - macOS Desktop App",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaVaGi-eu/receipts-manager.git"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "build:x64": "electron-builder --mac --x64",
    "build:universal": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "yauzl": "^3.2.1"
  },
  "build": {
    "appId": "eu.savagi.receipts-manager",
    "productName": "Receipt Manager",
    "asar": true,
    "icon": "../../media/branding/icon.icns",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../venv",
        "to": "venv",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../app.py",
        "to": "app.py"
      },
      {
        "from": "../../config.py",
        "to": "config.py"
      },
      {
        "from": "../../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../../services",
        "to": "services",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../routes",
        "to": "routes",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../templates",
        "to": "templates"
      },
      {
        "from": "../../static",
        "to": "static"
      },
      {
        "from": "../../data",
        "to": "data"
      },
      {
        "from": "../../storage",
        "to": "storage"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Receipt Manager ${version}",
      "background": "../../media/branding/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 144,
          "y": 200,
          "type": "file"
        },
        {
          "x": 396,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
