{
  "name": "receipt-warranty-manager",
  "version": "2.1.0",
  "description": "Receipt & Warranty Manager - macOS Desktop App",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "build:x64": "electron-builder --mac --x64",
    "build:universal": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "eu.savagi.receipts-manager",
    "productName": "Receipt Manager",
    "asar": true,
    "files": [
      "electron-main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../venv",
        "to": "venv",
        "filter": ["**/*", "!**/__pycache__", "!**/*.pyc"]
      },
      {
        "from": "../../app.py",
        "to": "app.py"
      },
      {
        "from": "../../config.py",
        "to": "config.py"
      },
      {
        "from": "../../ocr_service.py",
        "to": "ocr_service.py"
      },
      {
        "from": "../../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../../templates",
        "to": "templates"
      },
      {
        "from": "../../static",
        "to": "static"
      },
      {
        "from": "../../data",
        "to": "data"
      },
      {
        "from": "../../storage",
        "to": "storage"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": ["dmg"]
    },
    "dmg": {
      "title": "Receipt Manager ${version}",
      "icon": "build/icon.icns",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 144,
          "y": 200,
          "type": "file"
        },
        {
          "x": 396,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
