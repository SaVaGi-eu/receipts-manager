[flake8]
# Match black's line length
max-line-length = 120

# Exclude common directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build_env,
    build,
    dist,
    *.egg-info,
    node_modules,
    .pytest_cache,
    .mypy_cache

# Ignore specific rules that conflict with black or are too strict
# E203: whitespace before ':' (conflicts with black)
# E226: missing whitespace around arithmetic operator (style preference)
# E501: line too long (handled by black)
# W503: line break before binary operator (conflicts with black)
# E402: module level import not at top of file (sometimes needed)
# F841: local variable assigned but never used (often in exception handlers)
ignore = E203,E226,E501,W503,E402,F841

# Complexity settings - HTTP handlers are naturally complex
max-complexity = 35

# Enable specific checks
select = E,W,F,C

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    tests/*:F401,F811
    ocr_service.py:F401,F811
    check_deps.py:E741
